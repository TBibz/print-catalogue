# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (and Data API).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Only used by scripts on your own computer (e.g. the catalogue import).
# Never prefix this with NEXT_PUBLIC_ and never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET. Sending invoices by email through any SMTP mail server
# (lib/email.ts). Your email provider's help pages list these values,
# usually under "SMTP", "outgoing mail" or "set up a mail app".
#   SMTP_PORT: 465 = secure connection from the start (SSL/TLS),
#              587 = STARTTLS. Use whichever your provider says.
#   SMTP_USER: the login, usually the full email address.
#   SMTP_FROM_EMAIL: the address invoices come from. Most servers only
#              allow the login's own address. The sender's name is the
#              company name from Settings; replies go to the company email.
# Server-side only: never prefix these with NEXT_PUBLIC_. Add them to Vercel
# too, then redeploy. Leave them out and the Send button says "Email not set
# up yet"; Download PDF still works. Settings → Email has "Send test email".
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=invoices@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=invoices@example.com

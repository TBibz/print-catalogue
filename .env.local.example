# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (and Data API).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Only used by scripts on your own computer (e.g. the catalogue import).
# Never prefix this with NEXT_PUBLIC_ and never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET. Sending invoices by email through a Gmail account (lib/email.ts).
# GMAIL_APP_PASSWORD is a 16-character Google "app password" for that
# account (not its normal password). Server-side only: never prefix these
# with NEXT_PUBLIC_. Add them to Vercel too. Leave them out and the Send
# button says "Email not set up yet"; Download PDF still works.
GMAIL_USER=someone@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
